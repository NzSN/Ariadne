  "boundary": {
    "input": "validated decoded instruction with successful instruction fetch and length 1..15",
    "output": "completed instruction step or specified synchronous fault at the architectural boundary",
    "asynchronous": "events between instruction boundaries; handler entry and OS execution outside this profile",
    "memory": "ordinary write-back RAM, homogeneous type per span, explicit byte mapping and permissions; canonicality/alignment checked; absent mapping/type evidence remains unavailable",
    "concurrency": "single-logical-processor step; no cross-thread/coherence claim",
    "fault_priority": "architectural priority across groups; any within-group implementation policy is fixed by the processor profile"
  },
  "excluded": [
    "legacy/compatibility/virtual8086 modes",
    "privileged/system instruction execution",
    "far transfers, interrupt gates, descriptor loads and task switching",
    "CET/shadow-stack control transfers",
    "LOCK/atomic, fence and multiprocessor-ordering claims",
    "MMIO and port I/O",
    "LWP, MONITORX/MWAITX and optional BMI/TBM/vector/x87 instruction execution",
    "unlisted forms and unreviewed prefix combinations"
  ],
  "state_policy": "retain canonical storage; specify all touched fields and prove frames for untouched banks; architectural undefined values remain relational",
  "case_hash_contract": "Each accepted case hash binds the complete current source form, milestone, projected operand kinds, implementation stage, reviewed profile-case source evidence and closed open-obligation list; any change invalidates prior case evidence.",
