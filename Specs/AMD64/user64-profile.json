    "foundation_id": "unsupported-analysis-fallback",
    "action": "explicit unsupported; add no concrete conclusions; invalidate potentially affected value/memory facts and unresolved control-flow dependencies",
    "not_architectural_fault": true,
    "not_noop": true
  },
  "required_case_obligations": [
    "conservative-analysis-projection",
    "decoded-form-legality",
    "effects-flags-and-frames",
    "fault-and-commit-behavior",
    "instruction-boundary",
    "operand-payload-binding",
    "state-validity",
    "tla-lean-correspondence"
  ],
