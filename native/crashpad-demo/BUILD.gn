# Staged by the demo bootstrap at //examples/ariadne_demo in the Crashpad tree.
import("//build/crashpad_buildconfig.gni")

assert(crashpad_is_win || crashpad_is_linux,
       "The Ariadne Crashpad demo supports Windows and Linux.")

crashpad_executable("ariadne_crash_demo") {
  sources = [
    "crash_demo.cc",
    "fault.cc",
  ]

  if (crashpad_is_win) {
    assert(current_cpu == "x64", "The controlled workload requires Windows x64.")
    sources += [ "bap_workload.asm" ]
  }

  deps = [ "//client:client" ]
  data_deps = [
    "//handler:crashpad_handler",
    "//tools:crashpad_database_util",
  ]
}
