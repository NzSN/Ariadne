package "conf-clang" {
  opam-version: "2.0"
  version: "2"
  synopsis: "Virtual package relying on clang"
  description:
    "This package can only install if the clang binary is installed on the system."
  maintainer: "https://github.com/ocaml/opam-repository/issues"
  authors: "The LLVM devs"
  license: "University of Illinois/NCSA Open Source License"
  homepage: "https://clang.llvm.org/"
  bug-reports: "https://github.com/ocaml/opam-repository/issues"
  flags: conf
  build: ["clang" "--version"]
  depexts: [
    ["clang"] {os-family = "debian"}
    ["clang"] {os-family = "ubuntu"}
    ["clang"] {os-family = "fedora"}
    ["clang"] {os-distribution = "rhel"}
    ["clang"] {os-distribution = "centos"}
    ["clang"] {os-distribution = "alpine" & os-version <= "3.18"}
    ["clang17"]
      {os-distribution = "alpine" & os-version >= "3.19" &
       os-version < "3.21"}
    ["clang19"]
      {os-distribution = "alpine" & os-version >= "3.21" &
       os-version < "3.22"}
    ["clang20"]
      {os-distribution = "alpine" & os-version >= "3.22" &
       os-version < "3.23"}
    ["clang21"] {os-distribution = "alpine" & os-version >= "3.23"}
    ["clang"] {os-family = "suse" | os-family = "opensuse"}
    ["clang"] {os-distribution = "ol"}
    ["clang"] {os-distribution = "arch"}
    ["clang"] {os = "win32"}
  ]
}
package "conf-gmp" {
  opam-version: "2.0"
  version: "5"
  synopsis: "Virtual package relying on a GMP lib system installation"
  description:
    "This package can only install if the GMP lib is installed on the system."
