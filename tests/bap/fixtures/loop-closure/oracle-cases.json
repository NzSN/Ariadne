  "arithmetic_cases": [
    {
      "name": "negative-signed32-offset",
      "base": 4096,
      "bytes_hex": "fdffffff",
      "address_width": 64,
      "expected_offset": -3,
      "expected_target": 4093
    },
    {
      "name": "minimum-signed32-offset",
      "base": 4294967296,
      "bytes_hex": "00000080",
      "address_width": 64,
      "expected_offset": -2147483648,
      "expected_target": 2147483648
    },
    {
      "name": "negative-wrap64",
      "base": 1,
      "bytes_hex": "fdffffff",
      "address_width": 64,
      "expected_offset": -3,
      "expected_target": 18446744073709551614
    },
    {
      "name": "positive-wrap64",
      "base": 18446744073709551614,
      "bytes_hex": "04000000",
      "address_width": 64,
      "expected_offset": 4,
      "expected_target": 2
    }
