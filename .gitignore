# Temporary directories and caches, at any depth.
tmp/
temp/
.tmp/
.temp/
tmp-*/
temp-*/
.cache/
__pycache__/

# Apalache output and TLC state storage.
_apalache-out/
/states/
/Specs/**/states/

# Bazel-generated output directories and workspace symlinks.
/bazel-*

# Cargo build output.
/target/
/mbt/target/
/mbt/.work/

# Machine-specific MBT execution report.
/mbt/results/latest.json

# Lean proof build artifacts (the toolchain and dependency manifest are tracked).
/lean/.lake/

/input/target/
